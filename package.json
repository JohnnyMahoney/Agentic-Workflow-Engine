  "type": "module",
  "bugs": {
    "url": "https://github.com/JohnnyMahoney/Agentic-Workflow-Engine/issues"
  },
  "homepage": "https://github.com/JohnnyMahoney/Agentic-Workflow-Engine#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "playwright": "^1.64.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
