{
  "schemaVersion": "2.0",
  "id": "read-loaded-message",
  "version": "1.0.0",
  "description": "Open the dynamic loading example 2 page, click Start, wait for the asynchronously rendered message to become visible, extract its text, and confirm the message is visible.",
  "inputs": {},
  "targets": {
    "startButton": {
      "strategies": [
        {
          "kind": "role",
          "role": "button",
          "name": {
            "literal": "Start"
          },
          "frames": []
        },
        {
          "kind": "css",
          "selector": "#start button",
          "frames": []
        }
      ]
    },
    "loadedMessage": {
      "strategies": [
        {
          "kind": "css",
          "selector": "#finish h4",
          "frames": []
        }
      ]
    }
  },
  "steps": [
    {
      "id": "openPage",
      "action": "navigate",
      "url": "https://the-internet.herokuapp.com/dynamic_loading/2"
    },
    {
      "id": "clickStart",
      "action": "click",
      "target": "startButton"
    },
    {
      "id": "waitMessage",
      "action": "wait",
      "condition": {
        "kind": "visible",
        "target": "loadedMessage"
      },
      "timeoutMs": 15000
    },
    {
      "id": "readMessage",
      "action": "extract",
      "target": "loadedMessage",
      "saveAs": "messageText"
    }
  ],
  "outputs": {
    "message": {
      "type": "string",
      "description": "Visible message rendered after loading completes",
      "source": {
        "savedValue": "messageText"
      }
    }
  },
  "checkpoints": [
    {
      "kind": "visible",
      "target": "loadedMessage"
    }
  ]
}
