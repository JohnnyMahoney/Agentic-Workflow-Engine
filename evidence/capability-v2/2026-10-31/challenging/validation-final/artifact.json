{
  "schemaVersion": "2.0",
  "id": "read-row-and-edit",
  "version": "1.0.0",
  "description": "On the Challenging DOM page, find the table row whose first cell equals rowKey, read that row's Diceret cell (6th column), click the edit link in the same row, and report the cell value and final URL. Confirms the URL hash is #edit.",
  "inputs": {
    "rowKey": {
      "type": "string",
      "required": true,
      "description": "Exact text identifying the first cell of the desired row"
    }
  },
  "targets": {
    "diceretCell": {
      "strategies": [
        {
          "kind": "css",
          "selector": "td:nth-child(6)",
          "frames": [],
          "scope": {
            "css": "tbody tr",
            "has": {
              "css": "td",
              "text": {
                "input": "rowKey"
              }
            }
          }
        }
      ]
    },
    "editLink": {
      "strategies": [
        {
          "kind": "role",
          "role": "link",
          "name": {
            "literal": "edit"
          },
          "frames": [],
          "scope": {
            "css": "tbody tr",
            "has": {
              "css": "td",
              "text": {
                "input": "rowKey"
              }
            }
          }
        },
        {
          "kind": "css",
          "selector": "a[href='#edit']",
          "frames": [],
          "scope": {
            "css": "tbody tr",
            "has": {
              "css": "td",
              "text": {
                "input": "rowKey"
              }
            }
          }
        }
      ]
    }
  },
  "steps": [
    {
      "id": "openPage",
      "action": "navigate",
      "url": "https://the-internet.herokuapp.com/challenging_dom"
    },
    {
      "id": "readCell",
      "action": "extract",
      "target": "diceretCell",
      "saveAs": "cellValue"
    },
    {
      "id": "clickEdit",
      "action": "click",
      "target": "editLink"
    },
    {
      "id": "waitEditHash",
      "action": "wait",
      "condition": {
        "kind": "urlHash",
        "value": "#edit"
      },
      "timeoutMs": 5000
    }
  ],
  "outputs": {
    "cellValue": {
      "type": "string",
      "description": "Text from the Diceret cell of the selected row",
      "source": {
        "savedValue": "cellValue"
      }
    },
    "url": {
      "type": "string",
      "description": "Page URL after clicking edit",
      "source": {
        "page": "url"
      }
    }
  },
  "checkpoints": [
    {
      "kind": "urlHash",
      "value": "#edit"
    }
  ]
}
