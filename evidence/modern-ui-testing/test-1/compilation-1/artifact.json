{
  "schemaVersion": "2.0",
  "id": "modern-member-balance",
  "version": "1.0.0",
  "description": "Search Modern Bank member services for a member ID, open the matching result row's details, confirm the member ID, and return the account balance, account type, and member ID.",
  "inputs": {
    "memberId": {
      "type": "string",
      "required": true,
      "description": "Member ID to look up and confirm"
    }
  },
  "targets": {
    "queryInput": {
      "strategies": [
        {
          "kind": "role",
          "role": "textbox",
          "name": {
            "literal": "Member ID or name"
          },
          "frames": []
        },
        {
          "kind": "css",
          "selector": "#q",
          "frames": []
        }
      ]
    },
    "searchButton": {
      "strategies": [
        {
          "kind": "role",
          "role": "button",
          "name": {
            "literal": "Search"
          },
          "frames": []
        },
        {
          "kind": "css",
          "selector": "#f button[type=submit]",
          "frames": []
        }
      ]
    },
    "viewButton": {
      "strategies": [
        {
          "kind": "css",
          "selector": "button",
          "frames": [],
          "scope": {
            "css": "tbody tr",
            "has": {
              "css": "td",
              "text": {
                "input": "memberId"
              }
            }
          }
        }
      ]
    },
    "balanceValue": {
      "strategies": [
        {
          "kind": "css",
          "selector": "#out output",
          "frames": []
        }
      ]
    },
    "accountTypeValue": {
      "strategies": [
        {
          "kind": "css",
          "selector": "#out dl dd:nth-of-type(3)",
          "frames": []
        }
      ]
    },
    "memberIdValue": {
      "strategies": [
        {
          "kind": "css",
          "selector": "#out dl dd:nth-of-type(1)",
          "frames": []
        }
      ]
    }
  },
  "steps": [
    {
      "id": "navigateHome",
      "action": "navigate",
      "url": "http://localhost:8080/modern.html"
    },
    {
      "id": "clickQuery",
      "action": "click",
      "target": "queryInput"
    },
    {
      "id": "fillQuery",
      "action": "fill",
      "target": "queryInput",
      "value": {
        "input": "memberId"
      }
    },
    {
      "id": "clickSearch",
      "action": "click",
      "target": "searchButton"
    },
    {
      "id": "waitResults",
      "action": "wait",
      "condition": {
        "kind": "visible",
        "target": "viewButton"
      },
      "timeoutMs": 10000
    },
    {
      "id": "clickView",
      "action": "click",
      "target": "viewButton"
    },
    {
      "id": "waitDetails",
      "action": "wait",
      "condition": {
        "kind": "visible",
        "target": "balanceValue"
      },
      "timeoutMs": 10000
    },
    {
      "id": "extractBalance",
      "action": "extract",
      "target": "balanceValue",
      "saveAs": "balanceText"
    },
    {
      "id": "extractAccountType",
      "action": "extract",
      "target": "accountTypeValue",
      "saveAs": "accountTypeText"
    },
    {
      "id": "extractMemberId",
      "action": "extract",
      "target": "memberIdValue",
      "saveAs": "memberIdText"
    },
    {
      "id": "assertMemberId",
      "action": "assert",
      "condition": {
        "kind": "textEquals",
        "target": "memberIdValue",
        "value": {
          "input": "memberId"
        }
      }
    }
  ],
  "outputs": {
    "balance": {
      "type": "string",
      "description": "Current account balance as displayed by the application, including currency",
      "source": {
        "savedValue": "balanceText"
      }
    },
    "accountType": {
      "type": "string",
      "description": "Account type displayed for the requested member",
      "source": {
        "savedValue": "accountTypeText"
      }
    },
    "memberId": {
      "type": "string",
      "description": "Member ID read from the account details and confirmed against the supplied memberId",
      "source": {
        "savedValue": "memberIdText"
      }
    }
  },
  "checkpoints": [
    {
      "kind": "textEquals",
      "target": "memberIdValue",
      "value": {
        "input": "memberId"
      }
    },
    {
      "kind": "visible",
      "target": "balanceValue"
    }
  ]
}
