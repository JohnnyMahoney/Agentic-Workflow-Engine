{
  "schemaVersion": "2.1",
  "outputs": [
    {
      "output": "balance",
      "stepId": "extractBalance",
      "property": "text",
      "condition": {
        "kind": "textMatches",
        "pattern": "\\$[0-9]{1,3}(,[0-9]{3})*\\.[0-9]{2}"
      },
      "positiveSample": "$50,000.00",
      "rejectedIntermediateValues": [],
      "limitation": "No distinct intermediate value was recorded for this output; only positive-sample compatibility is proven."
    },
    {
      "output": "accountType",
      "stepId": "extractAccountType",
      "property": "text",
      "condition": {
        "kind": "textMatches",
        "pattern": "[A-Za-z]+( [A-Za-z]+)*"
      },
      "positiveSample": "Term Deposit",
      "rejectedIntermediateValues": [],
      "limitation": "No distinct intermediate value was recorded for this output; only positive-sample compatibility is proven."
    },
    {
      "output": "memberId",
      "stepId": "extractMemberId",
      "property": "text",
      "condition": {
        "kind": "textEquals",
