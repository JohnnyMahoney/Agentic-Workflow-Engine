{
  "schemaVersion": "2.1",
  "id": "modernBankMemberBalanceLookup",
  "version": "1.0.0",
  "description": "Search Modern Bank member services for a member ID, open the matching member's details, confirm the member ID, and return the account balance, account type and member ID.",
  "inputs": {
    "memberId": {
      "type": "string",
      "required": true,
      "description": "Member ID to look up and confirm"
    }
  },
  "targets": {
    "searchInput": {
      "strategies": [
        {
          "kind": "css",
          "selector": "#q",
          "frames": []
        },
        {
          "kind": "role",
          "role": "textbox",
          "name": {
            "literal": "Member ID or name"
          },
          "frames": []
        }
      ]
    },
    "searchButton": {
      "strategies": [
        {
          "kind": "css",
          "selector": "#f button[type=submit]",
          "frames": []
        }
      ]
    },
    "viewButton": {
      "strategies": [
        {
          "kind": "css",
          "selector": "button",
          "frames": [],
          "scope": {
            "css": "#out tbody tr",
            "has": {
              "css": "td",
              "text": {
                "input": "memberId"
              }
            }
          }
        }
      ]
    },
    "detailsHeading": {
      "strategies": [
        {
          "kind": "css",
          "selector": "#out h2",
          "frames": []
        }
      ]
    },
    "memberIdValue": {
      "strategies": [
        {
          "kind": "css",
          "selector": "#out dd:nth-of-type(1)",
          "frames": []
        }
      ]
    },
    "accountTypeValue": {
      "strategies": [
        {
          "kind": "css",
          "selector": "#out dd:nth-of-type(3)",
          "frames": []
        }
      ]
    },
    "balanceValue": {
      "strategies": [
        {
          "kind": "css",
          "selector": "#out output",
          "frames": []
        }
      ]
    }
  },
  "steps": [
    {
      "id": "openApp",
      "action": "navigate",
      "url": "http://localhost:8080/modern.html"
    },
    {
      "id": "focusSearch",
      "action": "click",
      "target": "searchInput"
    },
    {
      "id": "enterMemberId",
      "action": "fill",
      "target": "searchInput",
      "value": {
        "input": "memberId"
      }
    },
    {
      "id": "submitSearch",
      "action": "click",
      "target": "searchButton"
    },
    {
      "id": "waitResults",
      "action": "wait",
      "condition": {
        "kind": "visible",
        "target": "viewButton"
      },
      "timeoutMs": 10000
    },
    {
      "id": "openDetails",
      "action": "click",
      "target": "viewButton"
    },
    {
      "id": "waitDetails",
      "action": "wait",
      "condition": {
        "kind": "textContains",
        "target": "memberIdValue",
        "value": {
          "input": "memberId"
        }
      },
      "timeoutMs": 10000
    },
    {
      "id": "extractBalance",
      "action": "extract",
      "target": "balanceValue",
      "property": "text",
      "saveAs": "balanceText",
      "retry": {
        "maxAttempts": 3,
        "delayMs": 500
      }
    },
    {
      "id": "extractAccountType",
      "action": "extract",
      "target": "accountTypeValue",
      "property": "text",
      "saveAs": "accountTypeText",
      "retry": {
        "maxAttempts": 3,
        "delayMs": 500
      }
    },
    {
      "id": "extractMemberId",
      "action": "extract",
      "target": "memberIdValue",
      "property": "text",
      "saveAs": "memberIdText",
      "retry": {
        "maxAttempts": 3,
        "delayMs": 500
      }
    }
  ],
  "outputs": {
    "balance": {
      "type": "string",
      "description": "Current account balance as displayed by the application, including currency",
      "source": {
        "savedValue": "balanceText"
      },
      "validation": {
        "condition": {
          "kind": "textMatches",
          "pattern": "\\$[0-9]{1,3}(,[0-9]{3})*\\.[0-9]{2}"
        },
        "timeoutMs": 10000
      }
    },
    "accountType": {
      "type": "string",
      "description": "Account type displayed for the requested member",
      "source": {
        "savedValue": "accountTypeText"
      },
      "validation": {
        "condition": {
          "kind": "textMatches",
          "pattern": "[A-Za-z]+( [A-Za-z]+)*"
        },
        "timeoutMs": 10000
      }
    },
    "memberId": {
      "type": "string",
      "description": "Member ID read from the account details and confirmed against the supplied memberId",
      "source": {
        "savedValue": "memberIdText"
      },
      "validation": {
        "condition": {
          "kind": "textEquals",
          "value": {
            "input": "memberId"
          }
        },
        "timeoutMs": 10000
      }
    }
  },
  "checkpoints": [
    {
      "kind": "textContains",
      "target": "memberIdValue",
      "value": {
        "input": "memberId"
      }
    },
    {
      "kind": "visible",
      "target": "detailsHeading"
    },
    {
      "kind": "visible",
      "target": "balanceValue"
    }
  ]
}
