{
  "capability": {
    "schemaVersion": "2.0",
    "id": "legacy-member-balance",
    "version": "1.0.0",
    "description": "Search for a member by ID in the legacy Member Services app, open the member's customer details, confirm the member ID, and return the displayed balance, account type and member ID.",
    "inputs": {
      "memberId": {
        "type": "string",
        "required": true,
        "description": "Member ID to look up and confirm"
      }
    },
    "targets": {
      "searchInput": {
        "strategies": [
          {
            "kind": "css",
            "selector": "input[name=qq]",
            "frames": [
              "iframe[name=content]"
            ]
          }
        ]
      },
      "searchButton": {
        "strategies": [
          {
            "kind": "css",
            "selector": "span.b",
            "frames": [
              "iframe[name=content]"
            ]
          }
        ]
      },
      "resultLink": {
        "strategies": [
          {
            "kind": "css",
            "selector": "u",
            "frames": [
              "iframe[name=content]"
            ],
            "scope": {
              "css": "td:has(> font)",
              "has": {
                "css": "u",
                "text": {
                  "input": "memberId"
                }
              }
            }
          }
        ]
      },
      "memberCell": {
        "strategies": [
          {
            "kind": "css",
            "selector": "td:nth-child(2)",
            "frames": [
              "iframe[name=content]"
            ],
            "scope": {
              "css": "table[cellpadding='4'] > tbody > tr",
              "has": {
                "css": "td",
                "text": {
                  "literal": "Member:"
                }
              }
            }
          }
        ]
      },
      "accountTypeCell": {
        "strategies": [
          {
            "kind": "css",
            "selector": "td:nth-child(2)",
            "frames": [
              "iframe[name=content]"
            ],
            "scope": {
              "css": "table[cellpadding='4'] > tbody > tr",
              "has": {
                "css": "td",
                "text": {
                  "literal": "Acct Type:"
                }
              }
            }
          }
        ]
      },
      "balanceCell": {
        "strategies": [
          {
            "kind": "css",
            "selector": "td:nth-child(2)",
            "frames": [
              "iframe[name=content]"
            ],
            "scope": {
              "css": "table[cellpadding='4'] > tbody > tr",
              "has": {
                "css": "td",
                "text": {
                  "literal": "Balance:"
                }
              }
            }
          }
        ]
      }
    },
    "steps": [
      {
        "id": "navigateHome",
        "action": "navigate",
        "url": "http://localhost:8080/legacy/index.html"
      },
      {
        "id": "focusSearch",
        "action": "click",
        "target": "searchInput"
      },
      {
        "id": "fillMember",
        "action": "fill",
        "target": "searchInput",
        "value": {
          "input": "memberId"
        }
      },
      {
        "id": "clickSearch",
        "action": "click",
        "target": "searchButton"
      },
      {
        "id": "waitResults",
        "action": "wait",
        "condition": {
          "kind": "visible",
          "target": "resultLink"
        },
        "timeoutMs": 15000
      },
      {
        "id": "openMember",
        "action": "click",
        "target": "resultLink"
      },
      {
        "id": "waitDetails",
        "action": "wait",
        "condition": {
          "kind": "visible",
          "target": "balanceCell"
        },
        "timeoutMs": 15000
      },
      {
        "id": "assertMember",
        "action": "assert",
        "condition": {
          "kind": "textEquals",
          "target": "memberCell",
          "value": {
            "input": "memberId"
          }
        }
      },
      {
        "id": "extractBalance",
        "action": "extract",
        "target": "balanceCell",
        "saveAs": "balanceValue"
      },
      {
        "id": "extractAccountType",
        "action": "extract",
        "target": "accountTypeCell",
        "saveAs": "accountTypeValue"
      },
      {
        "id": "extractMemberId",
        "action": "extract",
        "target": "memberCell",
        "saveAs": "memberIdValue"
      }
    ],
    "outputs": {
      "balance": {
        "type": "string",
        "description": "Current account balance as displayed by the application, including currency",
        "source": {
          "savedValue": "balanceValue"
        }
      },
      "accountType": {
        "type": "string",
        "description": "Account type displayed for the requested member",
        "source": {
          "savedValue": "accountTypeValue"
        }
      },
      "memberId": {
        "type": "string",
        "description": "Member ID read from the account details and confirmed against the supplied memberId",
        "source": {
          "savedValue": "memberIdValue"
        }
      }
    },
    "checkpoints": [
      {
        "kind": "textEquals",
        "target": "memberCell",
        "value": {
          "input": "memberId"
        }
      },
      {
        "kind": "visible",
        "target": "balanceCell"
      }
    ]
  },
  "stepEvidence": {
