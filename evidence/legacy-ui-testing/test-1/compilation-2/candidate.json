{
  "capability": {
    "schemaVersion": "2.0",
    "id": "legacy-member-balance",
    "version": "1.0.0",
    "description": "Search for a member by ID in the legacy Member Services app, open the matching member's details, confirm the member ID, and return the account balance, account type and member ID.",
    "inputs": {
      "memberId": {
        "type": "string",
        "required": true,
        "description": "Member ID to look up and confirm"
      }
    },
    "targets": {
      "searchInput": {
        "strategies": [
          {
            "kind": "css",
            "selector": "input[name=qq]",
            "frames": [
              "iframe[name=content]"
            ]
          }
        ]
      },
      "searchButton": {
        "strategies": [
          {
            "kind": "css",
            "selector": "span.b",
            "frames": [
              "iframe[name=content]"
            ]
          }
        ]
      },
      "resultLink": {
        "strategies": [
          {
            "kind": "css",
            "selector": "u",
            "frames": [
              "iframe[name=content]"
            ],
            "scope": {
              "css": "table table tr",
              "has": {
                "css": "td",
                "text": {
                  "input": "memberId"
                }
              }
            }
          }
        ]
      },
      "balanceValue": {
        "strategies": [
          {
            "kind": "css",
            "selector": "font[color=green] b",
            "frames": [
              "iframe[name=content]"
            ]
          }
        ]
      },
      "accountTypeValue": {
        "strategies": [
          {
            "kind": "css",
            "selector": "td:nth-child(2)",
            "frames": [
              "iframe[name=content]"
            ],
            "scope": {
              "css": "table table tr",
              "has": {
                "css": "td",
                "text": {
                  "literal": "Acct Type:"
                }
              }
            }
          }
        ]
      },
      "memberIdValue": {
        "strategies": [
          {
            "kind": "css",
            "selector": "td:nth-child(2)",
            "frames": [
              "iframe[name=content]"
            ],
            "scope": {
              "css": "table table tr",
              "has": {
                "css": "td",
                "text": {
                  "literal": "Member:"
                }
              }
            }
          }
        ]
      }
    },
    "steps": [
      {
        "id": "openApp",
        "action": "navigate",
        "url": "http://localhost:8080/legacy/index.html"
      },
      {
        "id": "focusSearch",
        "action": "click",
        "target": "searchInput"
      },
      {
        "id": "enterMemberId",
        "action": "fill",
        "target": "searchInput",
        "value": {
          "input": "memberId"
        }
      },
      {
        "id": "clickSearch",
        "action": "click",
        "target": "searchButton"
      },
      {
        "id": "waitResults",
        "action": "wait",
        "condition": {
          "kind": "visible",
          "target": "resultLink"
        },
        "timeoutMs": 10000
      },
      {
        "id": "openMember",
        "action": "click",
        "target": "resultLink"
      },
      {
        "id": "waitDetails",
        "action": "wait",
        "condition": {
          "kind": "visible",
          "target": "balanceValue"
        },
        "timeoutMs": 10000
      },
      {
        "id": "readBalance",
        "action": "extract",
        "target": "balanceValue",
        "saveAs": "balanceText"
      },
      {
        "id": "readAccountType",
        "action": "extract",
        "target": "accountTypeValue",
        "saveAs": "accountTypeText"
      },
      {
        "id": "readMemberId",
        "action": "extract",
        "target": "memberIdValue",
        "saveAs": "memberIdText"
      }
    ],
    "outputs": {
      "balance": {
        "type": "string",
        "description": "Current account balance as displayed by the application, including currency",
        "source": {
          "savedValue": "balanceText"
        }
      },
      "accountType": {
        "type": "string",
        "description": "Account type displayed for the requested member",
        "source": {
          "savedValue": "accountTypeText"
        }
      },
      "memberId": {
        "type": "string",
        "description": "Member ID read from the account details and confirmed against the supplied memberId",
        "source": {
          "savedValue": "memberIdText"
        }
      }
    },
    "checkpoints": [
      {
        "kind": "textEquals",
        "target": "memberIdValue",
        "value": {
          "input": "memberId"
        }
      },
      {
        "kind": "visible",
        "target": "balanceValue"
      }
    ]
  },
  "stepEvidence": {
    "openApp": {
      "action": 1,
      "phase": "after"
    },
    "focusSearch": {
      "action": 5,
      "phase": "before",
