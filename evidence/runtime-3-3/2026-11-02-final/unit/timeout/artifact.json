{
  "schemaVersion": "2.0",
  "id": "runtime-fixture",
  "version": "1.0.0",
  "description": "Unit fixture, not discovery",
  "inputs": {
    "id": {
      "type": "string",
      "required": true,
      "description": "Identity"
    }
  },
  "targets": {
    "state": {
      "strategies": [
        {
          "kind": "css",
          "selector": "#state",
          "frames": []
        }
      ]
    }
  },
  "steps": [
    {
      "id": "wait",
      "action": "wait",
      "condition": {
        "kind": "textContains",
        "target": "state",
        "value": {
          "literal": "confirmed"
        }
      },
      "timeoutMs": 50
    }
  ],
  "outputs": {},
  "checkpoints": [
    {
      "kind": "textContains",
      "target": "state",
      "value": {
        "input": "id"
      }
    }
  ]
}