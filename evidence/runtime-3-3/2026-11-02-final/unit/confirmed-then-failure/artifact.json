{
  "schemaVersion": "2.0",
  "id": "runtime-fixture",
  "version": "1.0.0",
  "description": "Unit fixture, not discovery",
  "inputs": {
    "id": {
      "type": "string",
      "required": true,
      "description": "Identity"
    }
  },
  "targets": {
    "state": {
      "strategies": [
        {
          "kind": "css",
          "selector": "#state",
          "frames": []
        }
      ]
    }
  },
  "steps": [
    {
      "id": "write",
      "action": "click",
      "target": "state",
      "effect": "stateChanging"
    },
    {
      "id": "confirm",
      "action": "wait",
      "condition": {
        "kind": "textContains",
        "target": "state",
        "value": {
          "input": "id"
        }
      },
      "timeoutMs": 80,
      "confirms": "write"
    },
    {
      "id": "later",
      "action": "assert",
      "condition": {
        "kind": "textEquals",
        "target": "state",
        "value": {
          "literal": "different"
        }
      }
    }
  ],
  "outputs": {},
  "checkpoints": [
    {
      "kind": "textContains",
      "target": "state",
      "value": {
        "input": "id"
      }
    }
  ]
}