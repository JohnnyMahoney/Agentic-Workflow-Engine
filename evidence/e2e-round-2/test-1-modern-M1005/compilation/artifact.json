{
  "schemaVersion": "2.0",
  "id": "modernMemberBalanceLookup",
  "version": "1.0.0",
  "description": "Search for a member by ID on the Modern Bank member services page, open their details, confirm the member ID, and return the account balance, account type and member ID.",
  "inputs": {
    "memberId": {
      "type": "string",
      "required": true,
      "description": "Member ID to look up and confirm"
    }
  },
  "targets": {
    "searchInput": {
      "strategies": [
        {
          "kind": "role",
          "role": "textbox",
          "name": {
            "literal": "Member ID or name"
          },
          "frames": []
        },
        {
          "kind": "css",
          "selector": "#q",
          "frames": []
        }
      ]
    },
    "searchButton": {
      "strategies": [
        {
          "kind": "role",
          "role": "button",
          "name": {
            "literal": "Search"
          },
          "frames": []
        },
        {
          "kind": "css",
          "selector": "#f button[type=submit]",
          "frames": []
        }
      ]
    },
    "viewButton": {
      "strategies": [
        {
          "kind": "css",
          "selector": "button",
          "frames": [],
          "scope": {
            "css": "#out tbody tr",
            "has": {
              "css": "td",
              "text": {
                "input": "memberId"
              }
            }
          }
        }
      ]
    },
    "detailMemberId": {
      "strategies": [
        {
          "kind": "css",
          "selector": "#out dl dd:nth-of-type(1)",
          "frames": []
        }
      ]
    },
    "detailAccountType": {
      "strategies": [
        {
          "kind": "css",
          "selector": "#out dl dd:nth-of-type(3)",
          "frames": []
        }
      ]
    },
    "detailBalance": {
      "strategies": [
        {
          "kind": "css",
          "selector": "#out output",
          "frames": []
        }
      ]
    }
  },
  "steps": [
    {
      "id": "navigateHome",
      "action": "navigate",
      "url": "http://localhost:8080/modern.html"
    },
    {
      "id": "focusSearch",
      "action": "click",
      "target": "searchInput"
    },
    {
      "id": "fillMemberId",
      "action": "fill",
      "target": "searchInput",
      "value": {
        "input": "memberId"
      }
    },
    {
      "id": "clickSearch",
      "action": "click",
      "target": "searchButton"
    },
    {
      "id": "waitResults",
      "action": "wait",
      "condition": {
        "kind": "visible",
        "target": "viewButton"
      },
      "timeoutMs": 10000
    },
    {
      "id": "clickView",
      "action": "click",
      "target": "viewButton"
    },
    {
      "id": "waitDetails",
      "action": "wait",
      "condition": {
        "kind": "visible",
        "target": "detailBalance"
      },
      "timeoutMs": 10000
    },
    {
      "id": "assertMemberId",
      "action": "assert",
      "condition": {
        "kind": "textContains",
        "target": "detailMemberId",
        "value": {
          "input": "memberId"
        }
      }
    },
    {
      "id": "extractBalance",
      "action": "extract",
      "target": "detailBalance",
      "saveAs": "balanceValue"
    },
    {
      "id": "extractAccountType",
      "action": "extract",
      "target": "detailAccountType",
      "saveAs": "accountTypeValue"
    },
    {
      "id": "extractMemberId",
      "action": "extract",
      "target": "detailMemberId",
      "saveAs": "memberIdValue"
    }
  ],
  "outputs": {
    "balance": {
      "type": "string",
      "description": "Current account balance as displayed by the application, including currency",
      "source": {
        "savedValue": "balanceValue"
      }
    },
    "accountType": {
      "type": "string",
      "description": "Account type displayed for the requested member",
      "source": {
        "savedValue": "accountTypeValue"
      }
    },
    "memberId": {
      "type": "string",
      "description": "Member ID read from the account details and confirmed against the supplied memberId",
      "source": {
        "savedValue": "memberIdValue"
      }
    }
  },
  "checkpoints": [
    {
      "kind": "textContains",
      "target": "detailMemberId",
      "value": {
        "input": "memberId"
      }
    },
    {
      "kind": "visible",
      "target": "detailBalance"
    }
  ]
}
