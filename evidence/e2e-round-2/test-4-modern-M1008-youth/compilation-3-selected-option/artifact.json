{
  "schemaVersion": "2.1",
  "id": "modernOpenSubAccount",
  "version": "1.0.0",
  "description": "Search for a member by ID, open the member's record, open a new sub-account of the requested type, and verify the confirmation message shows the sub-account was created.",
  "inputs": {
    "memberId": {
      "type": "string",
      "required": true,
      "description": "Member ID supplied by the user"
    },
    "accountType": {
      "type": "string",
      "required": true,
      "description": "Sub-account type supplied by the user"
    }
  },
  "targets": {
    "searchInput": {
      "strategies": [
        {
          "kind": "css",
          "selector": "#q",
          "frames": []
        },
        {
          "kind": "role",
          "role": "textbox",
          "name": {
            "literal": "Member ID or name"
          },
          "frames": []
        }
      ]
    },
    "searchButton": {
      "strategies": [
        {
          "kind": "role",
          "role": "button",
          "name": {
            "literal": "Search"
          },
          "frames": []
        },
        {
          "kind": "css",
          "selector": "#f button[type=submit]",
          "frames": []
        }
      ]
    },
    "viewButton": {
      "strategies": [
        {
          "kind": "css",
          "selector": "button",
          "frames": [],
          "scope": {
            "css": "tbody tr",
            "has": {
              "css": "td",
              "text": {
                "input": "memberId"
              }
            }
          }
        }
      ]
    },
    "memberIdValue": {
      "strategies": [
        {
          "kind": "css",
          "selector": "#out dd:first-of-type",
          "frames": []
        }
      ]
    },
    "openSubAccountButton": {
      "strategies": [
        {
          "kind": "role",
          "role": "button",
          "name": {
            "literal": "Open sub-account"
          },
          "frames": []
        },
        {
          "kind": "css",
          "selector": "#o",
          "frames": []
        }
      ]
    },
    "accountTypeSelect": {
      "strategies": [
        {
          "kind": "css",
          "selector": "#t",
          "frames": []
        },
        {
          "kind": "role",
          "role": "combobox",
          "name": {
            "literal": "Account type"
          },
          "frames": []
        }
      ]
    },
    "continueButton": {
      "strategies": [
        {
          "kind": "role",
          "role": "button",
          "name": {
            "literal": "Continue"
          },
          "frames": []
        },
        {
          "kind": "css",
          "selector": "#w button:not([type=button])",
          "frames": []
        }
      ]
    },
    "confirmationStatus": {
      "strategies": [
        {
          "kind": "css",
          "selector": "#out p[role=status]",
          "frames": []
        }
      ]
    }
  },
  "steps": [
    {
      "id": "openApp",
      "action": "navigate",
      "url": "http://localhost:8080/modern.html"
    },
    {
      "id": "focusSearch",
      "action": "click",
      "target": "searchInput"
    },
    {
      "id": "enterMemberId",
      "action": "fill",
      "target": "searchInput",
      "value": {
        "input": "memberId"
      }
    },
    {
      "id": "clickSearch",
      "action": "click",
      "target": "searchButton"
    },
    {
      "id": "waitResults",
      "action": "wait",
      "condition": {
        "kind": "visible",
        "target": "viewButton"
      },
      "timeoutMs": 10000
    },
    {
      "id": "clickView",
      "action": "click",
      "target": "viewButton"
    },
    {
      "id": "waitDetails",
      "action": "wait",
      "condition": {
        "kind": "visible",
        "target": "openSubAccountButton"
      },
      "timeoutMs": 10000
    },
    {
      "id": "extractMemberId",
      "action": "extract",
      "target": "memberIdValue",
      "property": "text",
      "saveAs": "memberIdSaved",
      "retry": {
        "maxAttempts": 3,
        "delayMs": 500
      }
    },
    {
      "id": "clickOpen",
      "action": "click",
      "target": "openSubAccountButton"
    },
    {
      "id": "waitForm",
      "action": "wait",
      "condition": {
        "kind": "visible",
        "target": "accountTypeSelect"
      },
      "timeoutMs": 10000
    },
    {
      "id": "chooseType",
      "action": "selectOption",
      "target": "accountTypeSelect",
      "by": "label",
      "value": {
        "input": "accountType"
      }
    },
    {
      "id": "extractType",
      "action": "extract",
      "target": "accountTypeSelect",
      "property": "selectedOptionLabel",
      "saveAs": "accountTypeSaved"
    },
    {
      "id": "clickContinue",
      "action": "click",
      "target": "continueButton",
      "effect": "stateChanging"
    },
    {
      "id": "waitConfirmation",
      "action": "wait",
      "condition": {
        "kind": "textContains",
        "target": "confirmationStatus",
        "value": {
          "input": "memberId"
        }
      },
      "timeoutMs": 10000,
      "confirms": "clickContinue"
    },
    {
      "id": "assertType",
      "action": "assert",
      "condition": {
        "kind": "textContains",
        "target": "confirmationStatus",
        "value": {
          "input": "accountType"
        }
      }
    },
    {
      "id": "extractStatus",
      "action": "extract",
      "target": "confirmationStatus",
      "property": "text",
      "saveAs": "statusSaved",
      "retry": {
        "maxAttempts": 3,
        "delayMs": 500
      }
    }
  ],
  "outputs": {
    "memberId": {
      "type": "string",
      "description": "Member ID confirmed for the sub-account creation",
      "source": {
        "savedValue": "memberIdSaved"
      },
      "validation": {
        "condition": {
          "kind": "textEquals",
          "value": {
            "input": "memberId"
          }
        },
        "timeoutMs": 5000
      }
    },
    "accountType": {
      "type": "string",
      "description": "Selected sub-account type confirmed by the application",
      "source": {
        "savedValue": "accountTypeSaved"
      },
      "validation": {
        "condition": {
          "kind": "textEquals",
          "value": {
            "input": "accountType"
          }
        },
        "timeoutMs": 5000
      }
    },
    "status": {
      "type": "string",
      "description": "Observed confirmation of successful sub-account creation",
      "source": {
        "savedValue": "statusSaved"
      },
      "validation": {
        "condition": {
          "kind": "textMatches",
          "pattern": "Sub-account \\S+ \\([^)]+\\) opened for .+"
        },
        "timeoutMs": 5000
      }
    }
  },
  "checkpoints": [
    {
      "kind": "textContains",
      "target": "confirmationStatus",
      "value": {
        "input": "memberId"
      }
    },
    {
      "kind": "textContains",
      "target": "confirmationStatus",
      "value": {
        "input": "accountType"
      }
    }
  ]
}
