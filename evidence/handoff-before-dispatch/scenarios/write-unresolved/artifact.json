{
  "schemaVersion": "2.0",
  "id": "handoff-fixture",
  "version": "1.0.0",
  "description": "Hand-authored handoff regression fixture; no Claude run",
  "inputs": {},
  "targets": {
    "state": {
      "strategies": [
        {
          "kind": "css",
          "selector": "#state",
          "frames": []
        }
      ]
    }
  },
  "steps": [
    {
      "id": "three",
      "action": "click",
      "target": "state",
      "effect": "stateChanging"
    },
    {
      "id": "identity",
      "action": "assert",
      "condition": {
        "kind": "textContains",
        "target": "state",
        "value": {
          "literal": "member-1"
        }
      }
    },
    {
      "id": "type",
      "action": "assert",
      "condition": {
        "kind": "textContains",
        "target": "state",
        "value": {
          "literal": "Youth"
        }
      },
      "confirms": "three"
    }
  ],
  "outputs": {},
  "checkpoints": [
    {
      "kind": "textEquals",
      "target": "state",
      "value": {
        "literal": "Confirmed member-1 Youth"
      }
    }
  ]
}